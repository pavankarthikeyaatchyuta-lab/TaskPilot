# TaskPilot Configuration

# Database
# Default: local zero-config SQLite. For PostgreSQL (Neon/Supabase/local):
# DATABASE_URL=postgresql://user:password@localhost:5432/taskpilot
DATABASE_URL=sqlite:///./taskpilot.db

# LLM Provider ('mock', 'openai', or 'groq')
# Default is 'mock' which is 100% deterministic, offline, and ready for instant judging
LLM_PROVIDER=mock

# Optional: Real OpenAI integration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Real Groq integration
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# Workflow parameters
FOLLOW_UP_THRESHOLD_DAYS=14

# Frontend API URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
